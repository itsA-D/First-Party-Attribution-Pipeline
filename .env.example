# Runtime
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/urban_thread
ORDER_WEBHOOK_SECRET=local-development-secret
REPORTING_TIMEZONE=UTC
ATTRIBUTION_MODEL=last_click
ATTRIBUTION_LOOKBACK_DAYS=30
SESSION_TIMEOUT_MINUTES=30
HISTORICAL_VALIDITY_DAYS=365
IDENTITY_BACKFILL_DAYS=30
MAX_REQUEST_BYTES=1048576
LOG_LEVEL=INFO

# Worker
WORKER_POLL_SECONDS=1
WORKER_BATCH_SIZE=5
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=5

# Replay sender
API_BASE_URL=http://localhost:8000
REPLAY_CONCURRENCY=15
REPLAY_MAX_RETRIES=5
REPLAY_TIMEOUT_SECONDS=30
